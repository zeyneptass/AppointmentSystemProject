<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>57271349-833f-4d31-90a8-7aa81db74d6c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- API Dokümantasyonu -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
    
    <!-- EF Core Design Paketi (Senin versiyonunla güncellendi) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.22">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure Katmanına Bağlantı -->
    <ProjectReference Include="..\AppointmentSystem_Infrastructure\AppointmentSystem_Infrastructure.csproj" />
  </ItemGroup>

</Project>